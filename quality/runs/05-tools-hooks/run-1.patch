+package dev.vaadin.agentdemo.hello.ui;
+
+import com.vaadin.browserless.BrowserlessApplicationContext;
+import com.vaadin.browserless.BrowserlessUIContext;
+import com.vaadin.browserless.SpringBrowserlessApplicationContext;
+import com.vaadin.flow.component.notification.Notification;
+import com.vaadin.flow.component.sidenav.SideNavItem;
+import dev.vaadin.agentdemo.base.ui.MainLayout;
+import com.vaadin.flow.component.notification.NotificationVariant;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.ApplicationContext;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@SpringBootTest
+class HelloAgentWorldViewTest {
+
+    @Autowired
+    ApplicationContext spring;
+
+    private BrowserlessApplicationContext app;
+    private BrowserlessUIContext window;
+
+    @BeforeEach
+    void openHelloAgentWorld() {
+        app = SpringBrowserlessApplicationContext.create(spring,
+                HelloAgentWorldView.class, MainLayout.class);
+        window = app.newUser().newWindow();
+        window.navigate(HelloAgentWorldView.class);
+    }
+
+    @AfterEach
+    void close() {
+        app.close();
+    }
+
+    @Test
+    void visitorIsGreetedByName() {
+        enterName("Alice");
+        clickShow();
+
+        var greeting = window.findNotification()
+                .withTheme(NotificationVariant.SUCCESS);
+        assertEquals("Hello Alice!", greeting.getText());
+        assertEquals(Notification.Position.BOTTOM_END,
+                greeting.component().getPosition());
+    }
+
+    @Test
+    void surroundingWhitespaceIsNotPartOfTheGreeting() {
+        enterName("  Bob  ");
+        clickShow();
+
+        assertEquals("Hello Bob!", window.findNotification().getText());
+    }
+
+    @Test
+    void visitorWithoutANameIsAskedToEnterOne() {
+        enterName("   ");
+        clickShow();
+
+        assertFalse(window.findNotification().exists());
+        var field = window.findTextField().withLabel("Name").component();
+        assertTrue(field.isInvalid());
+        assertEquals("Please enter a name", field.getErrorMessage());
+    }
+
+    @Test
+    void visitorCanGreetAfterCorrectingAnEmptyName() {
+        clickShow();
+        enterName("Carol");
+        clickShow();
+
+        assertFalse(window.findTextField().withLabel("Name").component()
+                .isInvalid());
+        assertEquals("Hello Carol!", window.findNotification().getText());
+    }
+
+    @Test
+    void viewIsListedInTheNavigation() {
+        assertTrue(window.find(SideNavItem.class).all().stream()
+                .anyMatch(item -> "Hello Agent World".equals(item.getLabel())
+                        && "hello-agent-world".equals(item.getPath())));
+    }
+
+    private void enterName(String name) {
+        window.findTextField().withLabel("Name").setValue(name);
+    }
+
+    private void clickShow() {
+        window.findButton().withText("Show").click();
+    }
+}
