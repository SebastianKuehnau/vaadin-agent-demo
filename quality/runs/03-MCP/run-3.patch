+package dev.vaadin.agentdemo.hello;
+
+import com.vaadin.browserless.BrowserlessApplicationContext;
+import com.vaadin.browserless.BrowserlessUIContext;
+import com.vaadin.flow.component.button.ButtonVariant;
+import com.vaadin.flow.component.notification.Notification;
+import com.vaadin.flow.component.notification.NotificationVariant;
+import com.vaadin.flow.component.sidenav.SideNavItem;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@SpringBootTest
+class HelloAgentWorldViewTest {
+
+    @Autowired
+    private BrowserlessApplicationContext app;
+
+    private BrowserlessUIContext window;
+
+    @BeforeEach
+    void openWindow() {
+        window = app.newUser().newWindow();
+        window.navigate(HelloAgentWorldView.class);
+    }
+
+    @AfterEach
+    void closeUser() {
+        window.getUser().close();
+    }
+
+    @Test
+    void showButton_isPrimary() {
+        var button = window.findButton().withText("Show").component();
+        assertTrue(button.hasThemeName(ButtonVariant.PRIMARY.getVariantName()));
+    }
+
+    @Test
+    void enterName_clickShow_successNotificationInBottomEnd() {
+        window.findTextField().withLabel("Name").setValue("Agent");
+        window.findButton().withText("Show").click();
+
+        assertEquals("Hello Agent!", window.findNotification().getText());
+
+        Notification notification = window.find(Notification.class).single();
+        assertEquals(Notification.Position.BOTTOM_END, notification.getPosition());
+        assertTrue(notification.hasThemeName(NotificationVariant.SUCCESS.getVariantName()));
+    }
+
+    @Test
+    void emptyName_clickShow_showsErrorInsteadOfGreeting() {
+        window.findButton().withText("Show").click();
+
+        var field = window.findTextField().withLabel("Name").component();
+        assertTrue(field.isInvalid());
+        assertEquals(HelloAgentWorldView.EMPTY_NAME_MESSAGE, field.getErrorMessage());
+
+        Notification notification = window.find(Notification.class).single();
+        assertEquals(HelloAgentWorldView.EMPTY_NAME_MESSAGE, window.test(notification).getText());
+        assertTrue(notification.hasThemeName(NotificationVariant.ERROR.getVariantName()));
+    }
+
+    @Test
+    void blankName_isTreatedAsEmpty() {
+        window.findTextField().withLabel("Name").setValue("   ");
+        window.findButton().withText("Show").click();
+
+        assertTrue(window.findTextField().withLabel("Name").component().isInvalid());
+        assertEquals(HelloAgentWorldView.EMPTY_NAME_MESSAGE, window.findNotification().getText());
+    }
+
+    @Test
+    void viewIsInNavigation() {
+        var labels = window.find(SideNavItem.class).all().stream()
+                .map(SideNavItem::getLabel).toList();
+        assertTrue(labels.contains("Hello Agent World"), "Navigation items: " + labels);
+    }
+}
