+package dev.vaadin.agentdemo.hello.ui;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.vaadin.browserless.BrowserlessApplicationContext;
+import com.vaadin.browserless.SpringBrowserlessApplicationContext;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.ApplicationContext;
+
+/**
+ * Use cases of the Hello Agent World view: a visitor enters their name and
+ * asks to be greeted.
+ */
+@SpringBootTest
+class HelloAgentWorldTest {
+
+    @Autowired
+    ApplicationContext spring;
+
+    BrowserlessApplicationContext app;
+
+    @BeforeEach
+    void openApp() {
+        app = SpringBrowserlessApplicationContext.create(spring,
+                HelloAgentWorldView.class);
+    }
+
+    @AfterEach
+    void closeApp() {
+        app.close();
+    }
+
+    @Test
+    void visitorIsGreetedByName() {
+        var page = new HelloAgentWorldPage(app.newUser().newWindow());
+
+        page.enterName("Alice");
+        page.clickShow();
+
+        assertEquals("Hello Alice!", page.notification());
+        assertTrue(page.notificationIsSuccessInBottomRight());
+    }
+
+    @Test
+    void greetingIgnoresSurroundingWhitespace() {
+        var page = new HelloAgentWorldPage(app.newUser().newWindow());
+
+        page.enterName("  Bob  ");
+        page.clickShow();
+
+        assertEquals("Hello Bob!", page.notification());
+    }
+
+    @Test
+    void visitorWithoutANameIsAskedToEnterOne() {
+        var page = new HelloAgentWorldPage(app.newUser().newWindow());
+
+        page.clickShow();
+
+        assertFalse(page.hasNotification());
+        assertEquals(HelloAgentWorldView.EMPTY_NAME_ERROR, page.nameFieldError());
+    }
+
+    @Test
+    void visitorWhoEntersOnlySpacesIsAskedToEnterAName() {
+        var page = new HelloAgentWorldPage(app.newUser().newWindow());
+
+        page.enterName("   ");
+        page.clickShow();
+
+        assertFalse(page.hasNotification());
+        assertEquals(HelloAgentWorldView.EMPTY_NAME_ERROR, page.nameFieldError());
+    }
+
+    @Test
+    void visitorWhoFixesAnEmptyNameIsGreeted() {
+        var page = new HelloAgentWorldPage(app.newUser().newWindow());
+
+        page.clickShow();
+        page.enterName("Carol");
+        assertNull(page.nameFieldError());
+        page.clickShow();
+
+        assertEquals("Hello Carol!", page.notification());
+    }
+
+    @Test
+    void showIsThePrimaryAction() {
+        var page = new HelloAgentWorldPage(app.newUser().newWindow());
+
+        assertTrue(page.showButtonIsPrimary());
+    }
+}
