+package dev.vaadin.agentdemo.hello.ui;
+
+import com.vaadin.flow.component.Key;
+import com.vaadin.flow.component.button.Button;
+import com.vaadin.flow.component.button.ButtonVariant;
+import com.vaadin.flow.component.notification.Notification;
+import com.vaadin.flow.component.notification.NotificationVariant;
+import com.vaadin.flow.component.orderedlayout.FlexComponent;
+import com.vaadin.flow.component.orderedlayout.HorizontalLayout;
+import com.vaadin.flow.component.orderedlayout.VerticalLayout;
+import com.vaadin.flow.component.textfield.TextField;
+import com.vaadin.flow.router.Menu;
+import com.vaadin.flow.router.PageTitle;
+import com.vaadin.flow.router.Route;
+
+/**
+ * Greets the user: enter a name, click <em>Show</em>, and a success
+ * notification says "Hello &lt;name&gt;!". An empty name is rejected on the
+ * field instead.
+ */
+@Route("hello-agent-world")
+@PageTitle("Hello Agent World")
+@Menu(order = 0, icon = "vaadin:hand", title = "Hello Agent World")
+public class HelloAgentWorldView extends VerticalLayout {
+
+    private final TextField name = new TextField("Name");
+
+    public HelloAgentWorldView() {
+        name.setRequiredIndicatorVisible(true);
+        name.setErrorMessage("Please enter a name");
+        name.setClearButtonVisible(true);
+
+        var show = new Button("Show", event -> greet());
+        show.addThemeVariants(ButtonVariant.PRIMARY);
+        show.addClickShortcut(Key.ENTER);
+
+        var row = new HorizontalLayout(name, show);
+        row.setDefaultVerticalComponentAlignment(FlexComponent.Alignment.BASELINE);
+        add(row);
+    }
+
+    private void greet() {
+        var value = name.getValue().strip();
+        if (value.isEmpty()) {
+            name.setInvalid(true);
+            name.focus();
+            return;
+        }
+        name.setInvalid(false);
+        var notification = Notification.show("Hello " + value + "!", 3000,
+                Notification.Position.BOTTOM_END);
+        notification.addThemeVariants(NotificationVariant.SUCCESS);
+    }
+}
