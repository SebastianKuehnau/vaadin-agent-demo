+package dev.vaadin.agentdemo.hello.ui;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.vaadin.browserless.BrowserlessApplicationContext;
+import com.vaadin.browserless.SpringBrowserlessApplicationContext;
+import dev.vaadin.agentdemo.Application;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.ApplicationContext;
+
+@SpringBootTest
+class HelloAgentWorldTest {
+
+    @Autowired
+    ApplicationContext spring;
+
+    BrowserlessApplicationContext app;
+
+    @BeforeEach
+    void openTheApp() {
+        app = SpringBrowserlessApplicationContext.create(spring, Application.class);
+    }
+
+    @AfterEach
+    void closeTheApp() {
+        app.close();
+    }
+
+    @Test
+    void visitorIsGreetedByName() {
+        Visitor visitor = new Visitor();
+
+        visitor.asksToBeGreetedAs("Agent");
+
+        assertTrue(visitor.wasToldThat("Hello Agent!"));
+        assertTrue(visitor.sawASuccessMessageInTheBottomRight());
+    }
+
+    @Test
+    void surroundingSpacesAreNotPartOfTheGreeting() {
+        Visitor visitor = new Visitor();
+
+        visitor.asksToBeGreetedAs("  Agent  ");
+
+        assertTrue(visitor.wasToldThat("Hello Agent!"));
+    }
+
+    @Test
+    void visitorWithoutANameIsAskedForOne() {
+        Visitor visitor = new Visitor();
+
+        visitor.asksToBeGreetedAs("");
+
+        assertFalse(visitor.wasGreeted());
+        assertEquals("Please enter a name", visitor.isAskedOnTheNameField());
+    }
+
+    @Test
+    void visitorWithOnlyBlanksAsNameIsAskedForOne() {
+        Visitor visitor = new Visitor();
+
+        visitor.asksToBeGreetedAs("   ");
+
+        assertFalse(visitor.wasGreeted());
+        assertEquals("Please enter a name", visitor.isAskedOnTheNameField());
+    }
+
+    @Test
+    void visitorWhoFixesAMissingNameIsGreeted() {
+        Visitor visitor = new Visitor();
+
+        visitor.asksToBeGreetedAs("");
+        visitor.asksToBeGreetedAs("Agent");
+
+        assertTrue(visitor.wasToldThat("Hello Agent!"));
+        assertNull(visitor.isAskedOnTheNameField());
+    }
+
+    @Test
+    void greetingIsThePrimaryActionAndListedInTheNavigation() {
+        Visitor visitor = new Visitor();
+
+        assertTrue(visitor.seesShowAsThePrimaryAction());
+        assertTrue(visitor.findsInTheNavigation("Hello Agent World"));
+    }
+
+    /** Actor: a visitor in their own browser window on the greeting view. */
+    class Visitor {
+
+        private final HelloAgentWorldPage page =
+                new HelloAgentWorldPage(app.newUser().newWindow());
+
+        Visitor() {
+            page.open();
+        }
+
+        void asksToBeGreetedAs(String name) {
+            page.enterName(name);
+            page.clickShow();
+        }
+
+        boolean wasGreeted() {
+            return page.hasNotification();
+        }
+
+        boolean wasToldThat(String message) {
+            return message.equals(page.notification());
+        }
+
+        boolean sawASuccessMessageInTheBottomRight() {
+            return page.notificationIsSuccessInBottomRight();
+        }
+
+        String isAskedOnTheNameField() {
+            return page.nameFieldError();
+        }
+
+        boolean seesShowAsThePrimaryAction() {
+            return page.showIsThePrimaryAction();
+        }
+
+        boolean findsInTheNavigation(String label) {
+            return page.navigationOffers(label);
+        }
+    }
+}
